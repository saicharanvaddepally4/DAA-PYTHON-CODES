
edges = [
    (1, 2, 2), (1, 3, 3), (2, 3, 1),
    (2, 4, 4), (3, 4, 5), (3, 5, 6),
    (4, 5, 7)
]

edges.sort(key=lambda x: x[2])
parent = {}

def find(x):
    parent.setdefault(x, x)
    if parent[x] != x:
        parent[x] = find(parent[x])
    return parent[x]

cost = 0
for u, v, w in edges:
    a, b = find(u), find(v)
    if a != b:
        parent[a] = b
        cost += w
        print(u, "-", v, ":", w)

print("Minimum Cost =", cost)
