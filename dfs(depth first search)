
def dfs(g, v, visited):
    if v not in visited:
        print(v, end=" ")
        visited.add(v)
        for n in g[v]:
            dfs(g, n, visited)

g = {
    0: [1, 2],
    1: [3, 4],
    2: [5, 6],
    3: [7, 8],
    4: [9],
    5: [10],
    6: [11],
    7: [], 8: [], 9: [],
    10: [], 11: []
}

dfs(g, 0, set())
